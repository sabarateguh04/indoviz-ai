DATA_DIR=./app/data
MODEL_PATH=./app/models_weights/yolo11n.pt
CONF_THRESHOLD_DEFAULT=0.4
CONF_THRESHOLD_MOTOR=0.25
IMGSZ_DEFAULT=640

# Data (kamera, zona, histori counting, alert) disimpan sebagai file JSON di
# DATA_DIR — bukan SQLite/PostgreSQL. Dipisah per kategori & tanggal, lihat
# app/db/store.py. RTSP URL kamera TIDAK dikonfigurasi di sini — semua
# kamera dikelola lewat UI (CameraManager). Lihat routes_cameras.py.

# --- branch main-prod: deteksi malam/low-light + GPU (lihat README backend) ---

# Deteksi yang lolos CONF_THRESHOLD_UNKNOWN tapi tidak lolos threshold
# per-kelas di atas TETAP dihitung, dilabel "tidak_diketahui" alih2 dibuang.
CONF_THRESHOLD_UNKNOWN=0.15

# Frame dgn kecerahan rata-rata di bawah ini (skala 0-255) dianggap footage
# malam/low-light dan di-enhance (CLAHE) dulu sebelum diinferensi.
ENABLE_LOW_LIGHT_ENHANCE=true
LOW_LIGHT_BRIGHTNESS_THRESHOLD=80

# "auto" -> pakai GPU (CUDA) kalau kedetect oleh torch, fallback CPU kalau
# tidak. Override manual mis. YOLO_DEVICE=cpu buat paksa CPU walau ada GPU,
# atau YOLO_DEVICE=cuda:1 buat pilih GPU tertentu di mesin multi-GPU.
YOLO_DEVICE=auto
